generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  SYSTEM
  SCHOOL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  TRANSFERRED
  COMPLETED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TRANSFERRED
  WITHDRAWN
  COMPLETED
  PROMOTED
  REPEATING
}

enum AdmissionType {
  NEW
  TRANSFER
  RETURNING
  RE_ENTRY
}

enum BoardingStatus {
  DAY
  BOARDING
}

enum GuardianRelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  OTHER
}

model School {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYears   AcademicYear[]
  memberships     SchoolMembership[]
  userRoles       UserRole[]
  students        Student[]
  academicClasses AcademicClass[]
  guardians       Guardian[]
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  terms       Term[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
}

model Term {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships SchoolMembership[]
  userRoles   UserRole[]
}

model SchoolMembership {
  id       String           @id @default(uuid())
  userId   String
  schoolId String
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  userRoles UserRole[]

  @@unique([userId, schoolId])
  @@index([schoolId])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  scope       RoleScope
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id       String  @id @default(uuid())
  userId   String
  roleId   String
  schoolId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  membership SchoolMembership? @relation(fields: [userId, schoolId], references: [userId, schoolId])

  @@unique([userId, roleId, schoolId])
  @@index([schoolId])
  @@index([roleId])
}

model Student {
  id                    String        @id @default(uuid())
  admissionNumber       String
  firstName             String
  middleName            String?
  lastName              String
  preferredName         String?
  gender                Gender
  dateOfBirth           DateTime
  placeOfBirth          String?
  nationality           String?
  religion              String?
  profilePhotoUrl       String?
  nationalId            String?
  birthCertificateNumber String?
  phone                 String?
  email                 String?
  address               String?
  district              String?
  municipality          String?
  village               String?
  status                StudentStatus @default(ACTIVE)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments      Enrollment[]
  studentGuardians StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
}

model AcademicClass {
  id          String   @id @default(uuid())
  name        String
  code        String
  level       Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  streams     Stream[]
  enrollments Enrollment[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Stream {
  id        String   @id @default(uuid())
  name      String
  code      String
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String
  class   AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]

  @@unique([classId, code])
  @@index([classId])
}

model Enrollment {
  id                String            @id @default(uuid())
  status            EnrollmentStatus  @default(PENDING)
  enrollmentDate    DateTime
  admissionType     AdmissionType     @default(NEW)
  previousSchool    String?
  previousClass     String?
  boardingStatus    BoardingStatus?
  house             String?
  remarks           String?
  withdrawalDate    DateTime?
  withdrawalReason  String?
  completedDate     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  studentId       String
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId  String
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  academicClassId String
  academicClass   AcademicClass  @relation(fields: [academicClassId], references: [id], onDelete: Restrict)

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
}

model Guardian {
  id                    String   @id @default(uuid())
  fullName              String
  phone                 String?
  alternatePhone        String?
  email                 String?
  address               String?
  occupation            String?
  preferredContactMethod String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentGuardians StudentGuardian[]

  @@index([schoolId])
}

model StudentGuardian {
  id                  String                     @id @default(uuid())
  relationshipType    GuardianRelationshipType
  isPrimary           Boolean                    @default(false)
  isEmergencyContact  Boolean                    @default(false)
  isAuthorizedPickup  Boolean                    @default(false)
  createdAt           DateTime                   @default(now())

  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
}
