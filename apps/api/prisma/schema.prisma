generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  SYSTEM
  SCHOOL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  TRANSFERRED
  COMPLETED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TRANSFERRED
  WITHDRAWN
  COMPLETED
  PROMOTED
  REPEATING
}

enum ReportCardStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISED
}

enum ProgressionDecision {
  PROMOTE
  REPEAT
  TRANSFER
  COMPLETE
  HOLD
}

enum AdmissionType {
  NEW
  TRANSFER
  RETURNING
  RE_ENTRY
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LEFT
}

enum BoardingStatus {
  DAY
  BOARDING
}

enum GuardianRelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  OTHER
}

model School {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYears            AcademicYear[]
  memberships              SchoolMembership[]
  userRoles                UserRole[]
  students                 Student[]
  academicClasses          AcademicClass[]
  guardians                Guardian[]
  educationSections        EducationSection[]
  academicOrganizations    AcademicOrganization[]
  academicLevels           AcademicLevel[]
  academicLevelProgressions AcademicLevelProgression[]
  reportCards              ReportCard[]
  studentProgressions      StudentAcademicProgression[]
  subjectCategories        SubjectCategory[]
  subjects                 Subject[]
  subjectOfferings         SubjectOffering[]
  subjectCombinations      SubjectCombination[]
  staffCategories          StaffCategory[]
  departments              Department[]
  staffPositions           StaffPosition[]
  staffMembers             Staff[]
  teachingAssignments      TeachingAssignment[]
  subjectAllocations       SubjectAllocation[]
  teachingGroups           TeachingGroup[]

  assessmentSchemes AssessmentScheme[]
  gradingSchemes    GradingScheme[]
  rankingPolicies   RankingPolicy[]
  assessments       Assessment[]
  learnerResults    LearnerResult[]
  examinations      Examination[]
  reportTemplates   ReportTemplate[]
  reportCards       ReportCard[]
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  terms       Term[]
  enrollments Enrollment[]
  reportCards ReportCard[]
  studentProgressions StudentAcademicProgression[]

  subjectOfferings SubjectOffering[]

  responsibilities    StaffResponsibility[]
  teachingAssignments TeachingAssignment[]

  subjectAllocations SubjectAllocation[]
  teachingGroups     TeachingGroup[]

  assessments    Assessment[]
  learnerResults LearnerResult[]
  examinations  Examination[]
  reportCards   ReportCard[]

  @@unique([schoolId, name])
}

model Term {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  assessments    Assessment[]
  learnerResults LearnerResult[]
  examinations  Examination[]
  reportCards   ReportCard[]

  @@unique([academicYearId, name])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships SchoolMembership[]
  userRoles   UserRole[]
  staffMembers Staff[]
}

model SchoolMembership {
  id       String           @id @default(uuid())
  userId   String
  schoolId String
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  userRoles UserRole[]

  @@unique([userId, schoolId])
  @@index([schoolId])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  scope       RoleScope
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id       String  @id @default(uuid())
  userId   String
  roleId   String
  schoolId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  membership SchoolMembership? @relation(fields: [userId, schoolId], references: [userId, schoolId])

  @@unique([userId, roleId, schoolId])
  @@index([schoolId])
  @@index([roleId])
}

