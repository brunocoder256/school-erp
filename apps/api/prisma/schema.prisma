generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  SYSTEM
  SCHOOL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  TRANSFERRED
  COMPLETED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TRANSFERRED
  WITHDRAWN
  COMPLETED
  PROMOTED
  REPEATING
}

enum AdmissionType {
  NEW
  TRANSFER
  RETURNING
  RE_ENTRY
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LEFT
}

enum BoardingStatus {
  DAY
  BOARDING
}

enum GuardianRelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  OTHER
}

model School {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYears            AcademicYear[]
  memberships              SchoolMembership[]
  userRoles                UserRole[]
  students                 Student[]
  academicClasses          AcademicClass[]
  guardians                Guardian[]
  educationSections        EducationSection[]
  academicOrganizations    AcademicOrganization[]
  academicLevels           AcademicLevel[]
  academicLevelProgressions AcademicLevelProgression[]
  subjectCategories        SubjectCategory[]
  subjects                 Subject[]
  subjectOfferings         SubjectOffering[]
  subjectCombinations      SubjectCombination[]
  staffCategories          StaffCategory[]
  departments              Department[]
  staffPositions           StaffPosition[]
  staffMembers             Staff[]
  teachingAssignments      TeachingAssignment[]
  subjectAllocations       SubjectAllocation[]
  teachingGroups           TeachingGroup[]

  assessmentSchemes AssessmentScheme[]
  gradingSchemes    GradingScheme[]
  rankingPolicies   RankingPolicy[]
  assessments       Assessment[]
  learnerResults    LearnerResult[]
  examinations      Examination[]
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  terms       Term[]
  enrollments Enrollment[]

  subjectOfferings SubjectOffering[]

  responsibilities    StaffResponsibility[]
  teachingAssignments TeachingAssignment[]

  subjectAllocations SubjectAllocation[]
  teachingGroups     TeachingGroup[]

  assessments    Assessment[]
  learnerResults LearnerResult[]
  examinations  Examination[]

  @@unique([schoolId, name])
}

model Term {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  assessments    Assessment[]
  learnerResults LearnerResult[]
  examinations  Examination[]

  @@unique([academicYearId, name])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships SchoolMembership[]
  userRoles   UserRole[]
  staffMembers Staff[]
}

model SchoolMembership {
  id       String           @id @default(uuid())
  userId   String
  schoolId String
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  userRoles UserRole[]

  @@unique([userId, schoolId])
  @@index([schoolId])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  scope       RoleScope
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id       String  @id @default(uuid())
  userId   String
  roleId   String
  schoolId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  membership SchoolMembership? @relation(fields: [userId, schoolId], references: [userId, schoolId])

  @@unique([userId, roleId, schoolId])
  @@index([schoolId])
  @@index([roleId])
}

model Student {
  id                    String        @id @default(uuid())
  admissionNumber       String
  firstName             String
  middleName            String?
  lastName              String
  preferredName         String?
  gender                Gender
  dateOfBirth           DateTime
  placeOfBirth          String?
  nationality           String?
  religion              String?
  profilePhotoUrl       String?
  nationalId            String?
  birthCertificateNumber String?
  phone                 String?
  email                 String?
  address               String?
  district              String?
  municipality          String?
  village               String?
  status                StudentStatus @default(ACTIVE)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments      Enrollment[]
  studentGuardians StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
}

model AcademicClass {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicLevelId String
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)

  streams     Stream[]
  enrollments Enrollment[]

  responsibilities    StaffResponsibility[]
  teachingAssignments TeachingAssignment[]

  subjectAllocations SubjectAllocation[]
  teachingGroups     TeachingGroup[]

  assessments Assessment[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([academicLevelId])
}

model Stream {
  id        String   @id @default(uuid())
  name      String
  code      String
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String
  class   AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]

  responsibilities    StaffResponsibility[]
  teachingAssignments TeachingAssignment[]

  subjectAllocations SubjectAllocation[]
  teachingGroups     TeachingGroup[]

  assessments Assessment[]

  @@unique([classId, code])
  @@index([classId])
}

model Enrollment {
  id                String            @id @default(uuid())
  status            EnrollmentStatus  @default(PENDING)
  enrollmentDate    DateTime
  admissionType     AdmissionType     @default(NEW)
  previousSchool    String?
  previousClass     String?
  boardingStatus    BoardingStatus?
  house             String?
  remarks           String?
  withdrawalDate    DateTime?
  withdrawalReason  String?
  completedDate     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  studentId       String
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId  String
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  academicClassId String
  academicClass   AcademicClass  @relation(fields: [academicClassId], references: [id], onDelete: Restrict)

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: Restrict)

  subjectCombinationId String?
  subjectCombination   SubjectCombination? @relation(fields: [subjectCombinationId], references: [id], onDelete: SetNull)

  subjectEnrollments StudentSubjectEnrollment[]

  assessmentScores AssessmentScore[]
  learnerResults   LearnerResult[]

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
}

model Guardian {
  id                    String   @id @default(uuid())
  fullName              String
  phone                 String?
  alternatePhone        String?
  email                 String?
  address               String?
  occupation            String?
  preferredContactMethod String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentGuardians StudentGuardian[]

  @@index([schoolId])
}

model StudentGuardian {
  id                  String                     @id @default(uuid())
  relationshipType    GuardianRelationshipType
  isPrimary           Boolean                    @default(false)
  isEmergencyContact  Boolean                    @default(false)
  isAuthorizedPickup  Boolean                    @default(false)
  createdAt           DateTime                   @default(now())

  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
}

model EducationSection {
  id           String   @id @default(uuid())
  name         String
  code         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  levels AcademicLevel[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model AcademicOrganization {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  levels AcademicLevel[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model AcademicLevel {
  id           String   @id @default(uuid())
  name         String
  code         String
  levelNumber  Int
  description  String?
  displayOrder Int      @default(0)
  canEnroll    Boolean  @default(true)
  isTerminal   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sectionId String
  section   EducationSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  academicOrganizationId String
  academicOrganization   AcademicOrganization @relation(fields: [academicOrganizationId], references: [id], onDelete: Restrict)

  classes        AcademicClass[]
  fromProgressions AcademicLevelProgression[] @relation("LevelProgressionFrom")
  toProgressions   AcademicLevelProgression[] @relation("LevelProgressionTo")
  subjectOfferings SubjectOffering[]
  subjectCombinations SubjectCombination[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([sectionId])
}

model AcademicLevelProgression {
  id           String   @id @default(uuid())
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  fromLevelId String
  fromLevel   AcademicLevel @relation("LevelProgressionFrom", fields: [fromLevelId], references: [id], onDelete: Restrict)

  toLevelId String
  toLevel   AcademicLevel @relation("LevelProgressionTo", fields: [toLevelId], references: [id], onDelete: Restrict)

  @@unique([schoolId, fromLevelId, toLevelId])
  @@index([schoolId])
  @@index([fromLevelId])
}

model SubjectCategory {
  id           String   @id @default(uuid())
  name         String
  code         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  subjects Subject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Subject {
  id           String   @id @default(uuid())
  name         String
  code         String
  shortName    String?
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  categoryId String
  category   SubjectCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  offerings    SubjectOffering[]
  combinations SubjectCombinationSubject[]

  subjectCapabilities     TeacherSubjectCapability[]
  teachingAssignments     TeachingAssignment[]
  studentSubjectEnrollments StudentSubjectEnrollment[]
  teachingGroups            TeachingGroup[]

  assessments   Assessment[]
  learnerResults LearnerResult[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([categoryId])
}

model SubjectOffering {
  id        String   @id @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  academicLevelId String
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  allocations SubjectAllocation[]

  @@unique([schoolId, subjectId, academicLevelId, academicYearId])
  @@index([schoolId])
  @@index([academicLevelId])
  @@index([academicYearId])
}

model SubjectCombination {
  id           String   @id @default(uuid())
  code         String
  name         String
  description  String?
  minSubjects  Int?
  maxSubjects  Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicLevelId String
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)

  subjects   SubjectCombinationSubject[]
  enrollments Enrollment[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([academicLevelId])
}

model SubjectCombinationSubject {
  id           String   @id @default(uuid())
  isRequired   Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  combinationId String
  combination   SubjectCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([combinationId, subjectId])
  @@index([subjectId])
}

model StaffCategory {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  displayOrder Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffMembers Staff[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffMembers      Staff[]
  responsibilities StaffResponsibility[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model StaffPosition {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffMembers Staff[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Staff {
  id               String       @id @default(uuid())
  staffNumber      String
  firstName        String
  middleName       String?
  lastName         String
  preferredName    String?
  email            String?
  phone            String?
  alternativePhone String?
  dateOfBirth      DateTime?
  gender           Gender?
  nationalId       String?
  address          String?
  employmentStatus StaffStatus   @default(ACTIVE)
  employmentType   String?
  joiningDate      DateTime?
  leavingDate      DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffCategoryId String?
  staffCategory   StaffCategory? @relation(fields: [staffCategoryId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  positionId String?
  position   StaffPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  teacherProfile     TeacherProfile?
  qualifications     StaffQualification[]
  subjectCapabilities TeacherSubjectCapability[]
  responsibilities  StaffResponsibility[]
  teachingAssignments TeachingAssignment[]

  @@unique([schoolId, staffNumber])
  @@index([schoolId])
  @@index([schoolId, employmentStatus])
  @@index([departmentId])
}

model TeacherProfile {
  id                            String   @id @default(uuid())
  specialization                String?
  yearsOfExperience             Int?
  professionalQualification     String?
  registrationNumber            String?
  registrationBody              String?
  registrationDate              DateTime?
  registrationExpiryDate        DateTime?
  registrationStatus            String?
  highestAcademicQualification  String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  staffId String @unique
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffQualification {
  id                String   @id @default(uuid())
  name              String
  institution       String?
  qualificationType String?
  fieldOfStudy      String?
  awardDate         DateTime?
  grade             String?
  certificateNumber String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  staffId String
  staff   Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model TeacherSubjectCapability {
  id        String   @id @default(uuid())
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  staffId String
  staff   Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([staffId, subjectId])
  @@index([staffId])
  @@index([subjectId])
}

model StaffResponsibility {
  id        String   @id @default(uuid())
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffId String
  staff   Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  classId String?
  class   AcademicClass? @relation(fields: [classId], references: [id], onDelete: Restrict)

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: Restrict)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([staffId])
  @@index([academicYearId])
}

model TeachingAssignment {
  id        String   @id @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffId String
  staff   Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  academicClassId String
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Restrict)

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: Restrict)

  teachingGroupId String?
  teachingGroup   TeachingGroup? @relation(fields: [teachingGroupId], references: [id], onDelete: SetNull)

  @@unique([schoolId, staffId, academicYearId, subjectId, academicClassId, streamId])
  @@index([schoolId])
  @@index([staffId])
  @@index([academicYearId])
  @@index([academicClassId])
  @@index([teachingGroupId])
}

/**
 * Links a subject offering to an actual academic context (year + class +
 * optional stream). The offering already pins the subject, level and year, so
 * an allocation answers "this subject is taught in this class/stream this
 * year". Duplicates are blocked at the database layer when a stream is set and
 * by the application for class-level (null stream) rows.
 */
model SubjectAllocation {
  id        String   @id @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  academicClassId String
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Restrict)

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: Restrict)

  subjectOfferingId String
  subjectOffering   SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict)

  @@unique([schoolId, academicYearId, academicClassId, streamId, subjectOfferingId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([academicClassId])
  @@index([subjectOfferingId])
}

/**
 * A stable operational unit for teaching: subject X in year Y for class Z
 * (optionally a specific stream). Teaching assignments aggregate into groups;
 * the students of a group resolve from the enrollments of that year/class/
 * stream context.
 */
model TeachingGroup {
  id        String   @id @default(uuid())
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  academicClassId String
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Restrict)

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  teachingAssignments TeachingAssignment[]

  assessments Assessment[]

  @@unique([schoolId, academicYearId, academicClassId, streamId, subjectId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([academicClassId])
  @@index([subjectId])
}

/**
 * A student's subject selection for a given academic enrollment. The tenant
 * relationship is studentSubjectEnrollment → enrollment → student → school.
 * Subject enrollments are historical: they are deactivated, never hard-deleted.
 */
model StudentSubjectEnrollment {
  id        String   @id @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, subjectId])
  @@index([subjectId])
}

enum AssessmentType {
  FORMATIVE
  SUMMATIVE
  CONTINUOUS_ASSESSMENT
  EXAMINATION
  PROJECT
  PRACTICAL
  PERFORMANCE
  COURSEWORK
  OBSERVATION
  COMPETENCY
  OTHER
}

enum AssessmentStatus {
  DRAFT
  COMPLETED
}

enum AssessmentScoreStatus {
  PRESENT
  ABSENT
  EXEMPT
  NOT_ASSESSED
  PENDING
  WITHHELD
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  LOCKED
  AMENDED
}

enum SchemeVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum GradingSchemeVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RankingScope {
  CLASS
  STREAM
  ACADEMIC_LEVEL
  SCHOOL
}

enum RankingMethod {
  TOTAL_SCORE
  AVERAGE_SCORE
  AGGREGATE
}

enum RankingTieHandling {
  COMPETITION
  DENSE
}

enum ExaminationStatus {
  DRAFT
  COMPLETED
  LOCKED
}

enum ExaminationPaperStatus {
  DRAFT
  COMPLETED
}

/**
 * Configurable assessment scheme (e.g. Lower Secondary CBC, Term Assessment).
 * Schemes are school-scoped configuration; they are never hard-coded in
 * business logic. Rules live in immutable versions so finalized results keep
 * the configuration that produced them.
 */
model AssessmentScheme {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  versions AssessmentSchemeVersion[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model AssessmentSchemeVersion {
  id            String               @id @default(uuid())
  versionNumber Int
  name          String?
  status        SchemeVersionStatus  @default(DRAFT)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  assessmentSchemeId String
  assessmentScheme   AssessmentScheme @relation(fields: [assessmentSchemeId], references: [id], onDelete: Cascade)

  gradingSchemeVersionId String?
  gradingSchemeVersion   GradingSchemeVersion? @relation(fields: [gradingSchemeVersionId], references: [id], onDelete: SetNull)

  rankingPolicyId String?
  rankingPolicy   RankingPolicy? @relation(fields: [rankingPolicyId], references: [id], onDelete: SetNull)

  components  SchemeComponentDefinition[]
  assessments Assessment[]
  results     LearnerResult[]

  @@unique([assessmentSchemeId, versionNumber])
  @@index([assessmentSchemeId])
  @@index([gradingSchemeVersionId])
  @@index([rankingPolicyId])
}

/**
 * The canonical weighted components of a scheme version. Weight is expressed
 * as an integer percentage; scheme weights must sum to 100.
 */
model SchemeComponentDefinition {
  id           String   @id @default(uuid())
  name         String
  code         String?
  displayOrder Int      @default(0)
  weight       Int
  maxScore     Decimal  @db.Decimal(6, 2)
  createdAt    DateTime @default(now())

  schemeVersionId String
  schemeVersion   AssessmentSchemeVersion @relation(fields: [schemeVersionId], references: [id], onDelete: Cascade)

  assessmentComponents AssessmentComponent[]

  @@unique([schemeVersionId, code])
  @@index([schemeVersionId])
}

model GradingScheme {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  versions GradingSchemeVersion[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model GradingSchemeVersion {
  id            String                      @id @default(uuid())
  versionNumber Int
  name          String?
  status        GradingSchemeVersionStatus  @default(DRAFT)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  gradingSchemeId String
  gradingScheme   GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  bands          GradingBand[]
  usedByVersions AssessmentSchemeVersion[]
  results        LearnerResult[]

  @@unique([gradingSchemeId, versionNumber])
  @@index([gradingSchemeId])
}

/**
 * A score range mapped to a grade, descriptor and achievement level. Bands
 * are inclusive on both ends; overlaps are rejected by the application layer.
 */
model GradingBand {
  id               String   @id @default(uuid())
  minScore         Decimal  @db.Decimal(6, 2)
  maxScore         Decimal  @db.Decimal(6, 2)
  grade            String
  descriptor       String?
  achievementLevel String?
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())

  versionId String
  version   GradingSchemeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model RankingPolicy {
  id          String            @id @default(uuid())
  name        String
  code        String
  enabled     Boolean           @default(true)
  scope       RankingScope
  method      RankingMethod     @default(AVERAGE_SCORE)
  tieHandling RankingTieHandling @default(COMPETITION)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  usedByVersions AssessmentSchemeVersion[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

/**
 * An actual assessment activity/event anchored to the M10 academic context
 * (school, year, term, subject, class, stream, optional teaching group). The
 * scheme version defines how the assessment's component scores are weighted.
 */
model Assessment {
  id        String          @id @default(uuid())
  name      String
  code      String?
  type      AssessmentType
  date      DateTime?
  status    AssessmentStatus @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  termId String?
  term   Term? @relation(fields: [termId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  academicClassId String
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Restrict)

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: Restrict)

  teachingGroupId String?
  teachingGroup   TeachingGroup? @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)

  schemeVersionId String?
  schemeVersion   AssessmentSchemeVersion? @relation(fields: [schemeVersionId], references: [id], onDelete: SetNull)

  components          AssessmentComponent[] @relation("AssessmentComponents")
  sourceOfComponents  AssessmentComponent[] @relation("AssessmentSourceComponents")
  scores              AssessmentScore[]
  results             LearnerResult[]
  papers              ExaminationPaper[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([termId])
  @@index([academicClassId])
  @@index([streamId])
  @@index([teachingGroupId])
  @@index([subjectId])
  @@index([schemeVersionId])
}

/**
 * A scored part of an assessment. Every assessment has at least one component
 * (a default "Total" component is created when no parts are supplied) so
 * scores always attach to a component. An optional source assessment lets a
 * continuous-assessment component derive its score from another assessment's
 * finalized result.
 */
model AssessmentComponent {
  id           String    @id @default(uuid())
  name         String
  code         String?
  displayOrder Int       @default(0)
  weight       Int?
  maxScore     Decimal   @db.Decimal(6, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assessmentId String
  assessment   Assessment @relation("AssessmentComponents", fields: [assessmentId], references: [id], onDelete: Cascade)

  schemeComponentDefinitionId String?
  schemeComponentDefinition   SchemeComponentDefinition? @relation(fields: [schemeComponentDefinitionId], references: [id], onDelete: SetNull)

  sourceAssessmentId String?
  sourceAssessment   Assessment? @relation("AssessmentSourceComponents", fields: [sourceAssessmentId], references: [id], onDelete: SetNull)

  scores AssessmentScore[]

  @@unique([assessmentId, code])
  @@index([assessmentId])
  @@index([schemeComponentDefinitionId])
  @@index([sourceAssessmentId])
}

/**
 * A learner's score on an assessment component. Absent is not zero: an absent
 * learner has no score and is excluded from the calculation unless a policy
 * says otherwise.
 */
model AssessmentScore {
  id           String              @id @default(uuid())
  score        Decimal?            @db.Decimal(6, 2)
  status       AssessmentScoreStatus @default(PRESENT)
  comment      String?
  recordedById String?             @db.Uuid
  recordedAt   DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  componentId String
  component   AssessmentComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([componentId, enrollmentId])
  @@index([assessmentId])
  @@index([enrollmentId])
}

/**
 * The stable, explainable outcome of an assessment for a learner: the final
 * score, grade, descriptor and achievement level plus the scheme and grading
 * versions used to produce them. Results move through a controlled lifecycle
 * and finalized results are never silently overwritten.
 */
model LearnerResult {
  id                String       @id @default(uuid())
  finalScore        Decimal?     @db.Decimal(6, 2)
  grade             String?
  descriptor        String?
  achievementLevel  String?
  status            ResultStatus @default(DRAFT)
  calculatedAt      DateTime?
  amendedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  termId String?
  term   Term? @relation(fields: [termId], references: [id], onDelete: Restrict)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  schemeVersionId String?
  schemeVersion   AssessmentSchemeVersion? @relation(fields: [schemeVersionId], references: [id], onDelete: SetNull)

  gradingSchemeVersionId String?
  gradingSchemeVersion   GradingSchemeVersion? @relation(fields: [gradingSchemeVersionId], references: [id], onDelete: SetNull)

  amendments ResultAmendment[]

  @@unique([assessmentId, enrollmentId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([subjectId])
  @@index([status])
}

/**
 * A controlled correction of a finalized result. History is preserved: the
 * previous and new values, the actor, the reason and the timestamp are kept.
 */
model ResultAmendment {
  id                 String   @id @default(uuid())
  previousFinalScore Decimal? @db.Decimal(6, 2)
  previousGrade      String?
  previousDescriptor String?
  newFinalScore      Decimal? @db.Decimal(6, 2)
  newGrade           String?
  newDescriptor      String?
  reason             String
  amendedById        String?  @db.Uuid
  amendedAt          DateTime @default(now())

  resultId String
  result   LearnerResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
}

model Examination {
  id            String            @id @default(uuid())
  name          String
  code          String?
  date          DateTime?
  status        ExaminationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  termId String?
  term   Term? @relation(fields: [termId], references: [id], onDelete: Restrict)

  papers ExaminationPaper[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([academicYearId])
}

/**
 * A single paper of an examination. Scoring happens through the linked
 * assessment (one shared score/result path), so a paper carries its subject
 * and academic context via the assessment.
 */
model ExaminationPaper {
  id           String               @id @default(uuid())
  name         String
  code         String?
  displayOrder Int                  @default(0)
  status       ExaminationPaperStatus @default(DRAFT)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)

  assessmentId String @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@index([examinationId])
}
